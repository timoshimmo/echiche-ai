# Copy to .env.local. The app runs in DEMO mode if DATABASE_URL is omitted.
# For persistent storage, use a managed PostgreSQL database (e.g. Supabase).
DATABASE_URL=
# Optional: set to "false" to refuse in-memory fallback when DATABASE_URL is missing.
ALLOW_IN_MEMORY_DEMO=true
# Optional provider credentials are not needed for this deterministic first slice.
OPENAI_API_KEY=
# Future provider adapters should only read secrets server-side.
