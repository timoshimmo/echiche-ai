{
  "name": "echiche-production-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Echiche starter repository: project continuity and a first bounded reasoning run.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "postgres": "3.4.7",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "22.18.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    }
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
