          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "research_question": {
          "title": "Research Question",
          "type": "string"
        }
      },
      "required": [
        "query",
        "research_question",
        "rationale"
      ],
      "title": "ResearchQueryV1",
      "type": "object"
    }
  },
  "$id": "research-plan.v1.schema.json",
