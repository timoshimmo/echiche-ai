# Copy to .env.local for the web app. Placeholders only: never commit real values.
# Validated at server start (src/lib/server/config.ts). Invalid values stop a production server.

# PostgreSQL connection string (server-side only; never prefix with NEXT_PUBLIC_).
# Required when NODE_ENV=production. Example for a local disposable database:
#   DATABASE_URL=postgresql://echiche:change-me@localhost:5432/echiche_dev
DATABASE_URL=

# Development/test only. "true" allows ephemeral in-memory storage when DATABASE_URL is empty.
# Defaults to "false" (fail closed). Ignored, and refused, in production.
ALLOW_IN_MEMORY_DEMO=true

# No model or research provider is configured yet. Provider keys will live only in the
# Python worker's environment (ADR-001) once a provider is chosen (blueprint ADR, M4).
