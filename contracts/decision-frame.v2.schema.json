{
  "$defs": {
    "AssumptionV1": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "label": {
          "enum": [
            "fact",
            "inference",
            "hypothesis",
            "speculation",
            "unknown"
          ],
          "title": "Label",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "label",
        "confidence"
      ],
      "title": "AssumptionV1",
      "type": "object"
    },
    "MemoryConflictV1": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "title": "Conflict",
          "type": "string"
        },
        "ref": {
          "pattern": "^(M|D)[0-9]{1,3}$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "conflict"
      ],
      "title": "MemoryConflictV1",
      "type": "object"
    }
  },
  "$id": "decision-frame.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "v1 plus `memory_conflicts` (M6): remembered items the new question or context contradicts\nor may have made outdated, by the ref the application supplied.",
  "properties": {
    "assumptions": {
      "items": {
        "$ref": "#/$defs/AssumptionV1"
      },
      "maxItems": 10,
      "title": "Assumptions",
      "type": "array"
    },
    "clarification_needed": {
      "title": "Clarification Needed",
      "type": "boolean"
    },
    "clarifying_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Clarifying Question"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Constraints",
      "type": "array"
    },
    "criteria": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Criteria",
      "type": "array"
    },
    "decision_statement": {
      "title": "Decision Statement",
      "type": "string"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "memory_conflicts": {
      "items": {
        "$ref": "#/$defs/MemoryConflictV1"
      },
      "maxItems": 8,
      "title": "Memory Conflicts",
      "type": "array"
    },
    "options": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Options",
      "type": "array"
    },
    "research_questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Research Questions",
      "type": "array"
    },
    "time_horizon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Time Horizon"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Unknowns",
      "type": "array"
    }
  },
  "required": [
    "decision_statement",
    "goal",
    "time_horizon",
    "options",
    "criteria",
    "constraints",
    "assumptions",
    "unknowns",
    "research_questions",
    "clarification_needed",
    "clarifying_question",
    "memory_conflicts"
  ],
  "title": "DecisionFrameV2",
  "type": "object"
}
