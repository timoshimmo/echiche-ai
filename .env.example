# Copy to .env.local for the web app. Placeholders only: never commit real values.
# Validated at server start (src/lib/server/config.ts); a production server with
# invalid configuration exits. See docs/runbooks/supabase-setup.md for hosted values.

# Postgres, connecting AS echiche_web (never postgres / a service role). Local stack:
# `npm run db:start`, then run `npm run test:db:prepare` once with
# TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# to give echiche_web its local password.
DATABASE_URL=postgresql://echiche_web:test-only-password@127.0.0.1:54322/postgres

# Supabase Auth. For the local stack these come from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
# The PUBLISHABLE (or legacy anon) key. Never the secret/service-role key: the server
# refuses to start if one is supplied here or set as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_PUBLISHABLE_KEY=

# Exact origin the app is served from (CSRF checks, auth redirects).
# Required (https) in production; defaults to http://localhost:3000 otherwise.
APP_ORIGIN=http://localhost:3000

# Optional per-user hourly creation limits (defaults 30 / 20).
# PROJECT_CREATE_LIMIT_PER_HOUR=30
# RUN_CREATE_LIMIT_PER_HOUR=20

# Optional per-run budget caps (blueprint defaults). A user's explicit "resume" adds half again.
# RUN_BUDGET_MAX_STEPS=18
# RUN_BUDGET_MAX_ACTIVE_SECONDS=600
# RUN_BUDGET_MAX_RESEARCH_CALLS=8
# RUN_BUDGET_MAX_COST_USD=0.50

# The Python worker runs separately (see worker/README.md) with its own DATABASE_URL
# connecting AS echiche_worker.

# No model or research provider is configured yet. Provider keys will live only in the
# Python worker's environment (ADR-001) once a provider is chosen (M4).
